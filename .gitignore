# Dependencies
/vendor/

# Dev-only Node deps (Playwright for the browser pixel checks; never shipped
# in the release zip — production has no Node/build step). package.json +
# package-lock.json ARE tracked so the check is reproducible.
/node_modules/

# Screenshots emitted by tests/browser/ pixel checks (regenerated on each run).
/tests/browser/*.png

# Environment & secrets
.env
.env.*

# Databases
*.sqlite
*.sqlite3
*.db

# Runtime data — ignore contents, keep the directory skeleton
/var/*
!/var/.gitkeep
!/var/.htaccess
!/var/data
/var/data/*
!/var/data/.gitkeep

# Build output
/dist/

# PHPUnit cache
/.phpunit.cache

# Claude Code local settings
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db