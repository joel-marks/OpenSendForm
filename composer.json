{
    "name": "opensendform/opensendform",
    "description": "Free, open-source, self-hostable form-to-email service for shared cPanel/PHP hosting.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4",
        "slim/psr7": "^1",
        "php-di/php-di": "^7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "OpenSendForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSendForm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off phpunit",
        "serve": "php -S 0.0.0.0:8080 -t public"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
