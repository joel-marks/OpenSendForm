#!/usr/bin/env php
<?php

declare(strict_types=1);

use OpenSendForm\Clock\SystemClock;
use OpenSendForm\Config;
use OpenSendForm\Form\FormRepository;
use OpenSendForm\Mail\DeliveryService;
use OpenSendForm\Mail\MessageBuilder;
use OpenSendForm\Mail\PhpMailerMailer;
use OpenSendForm\Storage\Database;
use OpenSendForm\Storage\MigrationRunner;
use OpenSendForm\Submission\SubmissionRepository;

require dirname(__DIR__) . '/vendor/autoload.php';

/**
 * OpenSendForm command-line tool.
 *
 * Plain argv parsing, no libraries. Connects to the configured database,
 * applies any pending migrations, then dispatches a single command.
 */

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? null;
$args = array_slice($argv, 2);

if ($command === null) {
    fwrite(STDERR, usage());
    exit(1);
}

try {
    $config = Config::fromEnvironment();
    $db = Database::connect($config->dbDsn());
    (new MigrationRunner($db, dirname(__DIR__) . '/migrations'))->migrate();

    switch ($command) {
        case 'form:create':
            exit(cmdFormCreate($db, $args));
        case 'form:list':
            exit(cmdFormList($db));
        case 'form:enable':
            exit(cmdFormSetActive($db, $args, true));
        case 'form:disable':
            exit(cmdFormSetActive($db, $args, false));
        case 'mail:retry':
            exit(cmdMailRetry($db, $config));
        case 'mail:test':
            exit(cmdMailTest($config, $args));
        case 'submissions:list':
            exit(cmdSubmissionsList($db, $args));
        default:
            fwrite(STDERR, "Unknown command: {$command}\n\n" . usage());
            exit(1);
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}

/**
 * form:create --name= --recipient= --origin= (repeatable)
 */
function cmdFormCreate(Database $db, array $args): int
{
    $name = null;
    $recipient = null;
    $origins = [];

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--name=')) {
            $name = substr($arg, strlen('--name='));
        } elseif (str_starts_with($arg, '--recipient=')) {
            $recipient = substr($arg, strlen('--recipient='));
        } elseif (str_starts_with($arg, '--origin=')) {
            $origins[] = substr($arg, strlen('--origin='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($name === null || $recipient === null || $origins === []) {
        fwrite(STDERR, "form:create requires --name, --recipient and at least one --origin\n\n" . usage());
        return 1;
    }

    $form = (new FormRepository($db))->createForm($name, $recipient, $origins);

    fwrite(STDOUT, "Created form #{$form['id']} \"{$form['name']}\"\n");
    fwrite(STDOUT, "  form_key:   {$form['form_key']}\n");
    fwrite(STDOUT, "  recipient:  {$form['recipient_email']}\n");
    fwrite(STDOUT, '  origins:    ' . implode(', ', $form['allowed_origins']) . "\n");

    return 0;
}

/**
 * form:list
 */
function cmdFormList(Database $db): int
{
    $forms = (new FormRepository($db))->listForms();

    if ($forms === []) {
        fwrite(STDOUT, "No forms yet.\n");
        return 0;
    }

    foreach ($forms as $form) {
        $state = $form['is_active'] === 1 ? 'active' : 'disabled';
        fwrite(STDOUT, sprintf(
            "#%d  %s  [%s]  %s -> %s  origins: %s\n",
            $form['id'],
            $form['form_key'],
            $state,
            $form['name'],
            $form['recipient_email'],
            implode(', ', $form['allowed_origins'])
        ));
    }

    return 0;
}

/**
 * form:enable ID / form:disable ID
 */
function cmdFormSetActive(Database $db, array $args, bool $active): int
{
    $id = $args[0] ?? null;
    if ($id === null || !ctype_digit($id)) {
        $verb = $active ? 'enable' : 'disable';
        fwrite(STDERR, "form:{$verb} requires a numeric form ID\n\n" . usage());
        return 1;
    }

    $repo = new FormRepository($db);
    $updated = $repo->setActive((int) $id, $active);

    if (!$updated) {
        fwrite(STDERR, "No form found with ID {$id}\n");
        return 1;
    }

    $verb = $active ? 'enabled' : 'disabled';
    fwrite(STDOUT, "Form #{$id} {$verb}.\n");

    return 0;
}

/**
 * mail:retry — re-attempt every failed submission whose retry is due.
 *
 * Intended for a cPanel cron entry. Prints a one-line summary and always
 * exits 0 so a transient mail outage never marks the cron job as failing.
 */
function cmdMailRetry(Database $db, Config $config): int
{
    $delivery = buildDeliveryService($db, $config);
    $summary = $delivery->retryDue();

    fwrite(STDOUT, sprintf(
        "mail:retry — attempted %d: sent %d, failed %d, dead %d, skipped %d\n",
        $summary['attempted'],
        $summary[DeliveryService::RESULT_SENT],
        $summary[DeliveryService::RESULT_FAILED],
        $summary[DeliveryService::RESULT_DEAD],
        $summary[DeliveryService::RESULT_SKIPPED]
    ));

    return 0;
}

/**
 * mail:test --to=ADDRESS — send a fixed message through the configured SMTP.
 *
 * The CLI form of the installer's future test-send. Exits 0 on success, 1 on
 * failure (printing the error).
 */
function cmdMailTest(Config $config, array $args): int
{
    $to = null;
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--to=')) {
            $to = substr($arg, strlen('--to='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($to === null || filter_var($to, FILTER_VALIDATE_EMAIL) === false) {
        fwrite(STDERR, "mail:test requires a valid --to=ADDRESS\n\n" . usage());
        return 1;
    }

    $mailer = new PhpMailerMailer($config);
    try {
        $mailer->send(
            $to,
            null,
            'OpenSendForm test message',
            "This is a test message from OpenSendForm.\n\n"
            . "If you received it, your SMTP settings are working."
        );
    } catch (Throwable $e) {
        fwrite(STDERR, "mail:test FAILED sending to {$to}: " . $e->getMessage() . "\n");
        return 1;
    }

    fwrite(STDOUT, "mail:test OK — message sent to {$to} via {$config->smtpHost()}:{$config->smtpPort()}\n");

    return 0;
}

/**
 * submissions:list [--status=X] — metadata only; never any submitted content.
 */
function cmdSubmissionsList(Database $db, array $args): int
{
    $status = null;
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--status=')) {
            $status = substr($arg, strlen('--status='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    $rows = (new SubmissionRepository($db))->listSummaries($status);

    if ($rows === []) {
        fwrite(STDOUT, "No submissions" . ($status !== null ? " with status '{$status}'" : '') . ".\n");
        return 0;
    }

    foreach ($rows as $row) {
        fwrite(STDOUT, sprintf(
            "#%d  %s  %s  %s  attempts=%d\n",
            (int) $row['id'],
            (string) ($row['form_key'] ?? '(deleted form)'),
            (string) $row['created_at'],
            (string) $row['status'],
            (int) $row['attempts']
        ));
    }

    return 0;
}

/**
 * Assemble a DeliveryService from the configured SMTP transport.
 */
function buildDeliveryService(Database $db, Config $config): DeliveryService
{
    return new DeliveryService(
        new SubmissionRepository($db),
        new FormRepository($db),
        new MessageBuilder(),
        new PhpMailerMailer($config),
        $config,
        new SystemClock()
    );
}

function usage(): string
{
    return <<<TXT
    OpenSendForm CLI

    Usage:
      bin/osf form:create --name=NAME --recipient=EMAIL --origin=ORIGIN [--origin=ORIGIN ...]
      bin/osf form:list
      bin/osf form:enable ID
      bin/osf form:disable ID
      bin/osf mail:retry
      bin/osf mail:test --to=ADDRESS
      bin/osf submissions:list [--status=STATUS]

    Notes:
      --origin may be repeated to allow more than one origin.
      An origin is scheme+host+optional port, e.g. https://example.com
      mail:retry re-sends failed submissions whose backoff has elapsed
        (intended for a cPanel cron entry); it always exits 0.
      submissions:list shows metadata only — never submitted content.

    TXT;
}
